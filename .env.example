OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional per-model credentials used by cross-model launchers.
GPT5_API_KEY=
GPT5_BASE_URL=
GEMINI_API_KEY=
GEMINI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
QWEN_API_KEY=
QWEN_BASE_URL=

# Optional separate model used to generate adaptive attacks.
GENERATOR_API_KEY=
GENERATOR_BASE_URL=
GENERATOR_MODEL=gpt-5-mini

# Optional defense-side endpoint.
DEFENSE_API_KEY=
DEFENSE_BASE_URL=

# Optional source checkout for the full upstream CaMeL interpreter bridge.
CAMEL_UPSTREAM_SRC=

# Required only when running IPIGuard. Point to the upstream directory that
# contains the agentdojo package.
IPIGUARD_UPSTREAM_SRC=
