{
  "enforce_trajectory": true,
  "enforce_checklist": true,
  "allow_read_only_deviation": true,
  "strict_arg_match": true,
  "block_side_effect_after_plan": true,
  "fail_closed_when_no_constraints": false,
  "injection_isolation": true,
  "use_llm_classification": false,
  "use_llm_alignment_judge": false,
  "use_llm_injection_detection": false,
  "constraint_source_mode": "llm",
  "constraint_build_max_tools": 64,
  "constraint_build_max_chars": 16000,
  "read_only_prefixes": [
    "get_",
    "list_",
    "read_",
    "search_",
    "view_",
    "track_",
    "check_",
    "fetch_",
    "query_",
    "find_",
    "lookup_",
    "retrieve_",
    "show_",
    "count_"
  ],
  "side_effect_prefixes": [
    "send_",
    "transfer_",
    "pay_",
    "book_",
    "cancel_",
    "place_",
    "buy_",
    "sell_",
    "delete_",
    "write_",
    "update_",
    "set_",
    "control_",
    "create_",
    "add_",
    "remove_",
    "freeze_",
    "unlock_",
    "lock_",
    "post_",
    "submit_",
    "publish_",
    "modify_",
    "execute_",
    "move_",
    "rename_",
    "copy_",
    "compress_",
    "extract_",
    "archive_",
    "reply_",
    "forward_",
    "mark_",
    "reschedule_",
    "request_",
    "purchase_",
    "restart_",
    "schedule_",
    "acknowledge_",
    "apply_",
    "arm_",
    "disarm_",
    "check_in"
  ],
  "suspicious_patterns": [
    "ignore\\s+previous\\s+instructions",
    "new\\s+important\\s+instructions?",
    "you\\s+must\\s+instead",
    "do\\s+not\\s+follow\\s+the\\s+user",
    "reveal\\s+(?:the\\s+)?(?:secret|password|api\\s*key|credential)",
    "send\\s+.*\\s+to\\s+.*@",
    "override\\s+the\\s+task",
    "system\\s+prompt"
  ]
}
